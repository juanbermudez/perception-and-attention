{
  "name": "perception-and-attention",
  "version": "0.1.0",
  "description": "A review of some basics of human perception and attention, with an interactive 3D brain.",
  "private": true,
  "license": "MIT",
  "repository": "github:juanbermudez/perception-and-attention",
  "type": "module",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "marked": "18.0.14",
    "math": "0.1.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
